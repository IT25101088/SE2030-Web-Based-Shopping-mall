ded=0;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="615" as="sourcePoint" /><mxPoint x="500" y="615" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="Open support queue: GET /employee/inquiries" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="645" as="sourcePoint" /><mxPoint x="280" y="645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="GET /employee/inquiries" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="675" as="sourcePoint" /><mxPoint x="500" y="675" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="listOpenInquiries()" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="705" as="sourcePoint" /><mxPoint x="730" y="705" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m18" value="findByStatusNot(RESOLVED)" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="735" as="sourcePoint" /><mxPoint x="970" y="735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="SELECT OPEN and IN_PROGRESS inquiries" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="765" as="sourcePoint" /><mxPoint x="1210" y="765" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m20" value="Render support/employee-inquiry-list" style="endArrow=open;endFill=0;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="785" as="sourcePoint" /><mxPoint x="500" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m21" value="Submit reply: POST /employee/inquiries/{id}/respond" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="815" as="sourcePoint" /><mxPoint x="280" y="815" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="InquiryResponseForm(responseText)" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="845" as="sourcePoint" /><mxPoint x="500" y="845" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m23" value="respondToInquiry(id, form)" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="875" as="sourcePoint" /><mxPoint x="730" y="875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m24" value="Load inquiry and responder; save response; OPEN → IN_PROGRESS; assign employee if unassigned" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="905" as="sourcePoint" /><mxPoint x="970" y="905" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m25" value="INSERT inquiry_response; UPDATE inquiry" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="930" as="sourcePoint" /><mxPoint x="1210" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m26" value="Resolve: POST /employee/inquiries/{id}/resolve → updateStatus(id, RESOLVED)" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="955" as="sourcePoint" /><mxPoint x="280" y="955" as="targetPoint" /></mxGeometry></mxCell><mxCell id="limitation" value="Deletion and customer-side inquiry editing are not exposed by the current controllers. Employee response/status changes update inquiry state; inquiry responses are stored separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="975" width="1450" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>