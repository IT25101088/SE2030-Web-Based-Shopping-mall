" as="sourcePoint" /><mxPoint x="280" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p2" value="InquiryController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="120" width="150" height="48" as="geometry" /></mxCell><mxCell id="life2" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=4 4;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="168" as="sourcePoint" /><mxPoint x="500" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p3" value="InquiryService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="655" y="120" width="150" height="48" as="geometry" /></mxCell><mxCell id="life3" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=4 4;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="168" as="sourcePoint" /><mxPoint x="730" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p4" value="Repositories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="895" y="120" width="150" height="48" as="geometry" /></mxCell><mxCell id="life4" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=4 4;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="168" as="sourcePoint" /><mxPoint x="970" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5" value="Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="120" width="150" height="48" as="geometry" /></mxCell><mxCell id="life5" value="" style="endArrow=none;startArrow=none;dashed=1;dashPattern=4 4;strokeColor=